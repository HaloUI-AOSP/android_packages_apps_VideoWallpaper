<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
        <androidx.preference.Preference
            android:key="choose_video"
            android:title="@string/choose_video_file"
            android:summary="@string/choose_video_summary"
            android:persistent="false" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="play_with_sound"
            android:title="@string/play_video_with_sound"
            android:summaryOn="@string/enable"
            android:summaryOff="@string/disable"
            android:persistent="false" />
        <com.android.settingslib.widget.SliderPreference
            android:key="audio_volume"
            android:title="@string/audio_volume"
            android:min="0"
            android:max="100"
            android:persistent="false" />
</androidx.preference.PreferenceScreen>
